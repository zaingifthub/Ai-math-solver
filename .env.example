# ───────────── Core ─────────────
# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap, OAuth callbacks, Stripe redirects.
NEXT_PUBLIC_SITE_URL="https://aimathsolver.example.com"
NEXT_PUBLIC_SITE_NAME="AI Math Solver"

# ───────────── Database (PostgreSQL) ─────────────
DATABASE_URL="postgresql://mathsolver:CHANGE_ME@localhost:5432/mathsolver?schema=public"

# ───────────── Auth (NextAuth) ─────────────
# Must equal NEXT_PUBLIC_SITE_URL in production.
NEXTAUTH_URL="https://aimathsolver.example.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that are promoted to ADMIN on first sign-in / seed.
ADMIN_EMAILS="admin@example.com"

# ───────────── AI (Anthropic Claude) ─────────────
# Without a key the solver still works (math engine only); AI explanations, tutor and photo OCR are disabled.
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-opus-5-5)
AI_MODEL="claude-opus-5-5"
# Alternative AI provider, used when ANTHROPIC_API_KEY is empty (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ───────────── Email (password reset) ─────────────
# Any SMTP provider, e.g. Hostinger mail: smtps://you%40yourdomain.com:PASSWORD@smtp.hostinger.com:465
SMTP_URL=""
EMAIL_FROM="AI Math Solver <no-reply@yourdomain.com>"

# ───────────── Uploads ─────────────
# Directory for temporary image uploads (outside the web root). Files expire after UPLOAD_TTL_HOURS.
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="5242880"
UPLOAD_TTL_HOURS="24"
# Secret used to authorize the cleanup cron endpoint (/api/cron/cleanup)
CRON_SECRET="CHANGE_ME"

# ───────────── Stripe (optional until monetization is enabled) ─────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""
STRIPE_PRICE_EDUCATION_MONTHLY=""
STRIPE_PRICE_EDUCATION_YEARLY=""
NEXT_PUBLIC_STRIPE_ENABLED="false"

# ───────────── Analytics (optional) ─────────────
NEXT_PUBLIC_GA_ID=""
