// AI Math Solver — database schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  USER
  EDITOR
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
  EDUCATION
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EducationLevel {
  BEGINNER
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  COLLEGE
}

enum ProblemSource {
  TEXT
  IMAGE
  CALCULATOR
  PRACTICE
}

enum UsageKind {
  SOLVE
  AI_EXPLAIN
  TUTOR
  OCR
  PRACTICE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageType {
  PAGE
  RESOURCE
}

enum UploadStatus {
  PENDING
  PROCESSED
  FAILED
  DELETED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ─────────────────────────── Auth (NextAuth) ───────────────────────────

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             Role            @default(USER)
  status           UserStatus      @default(ACTIVE)
  plan             Plan            @default(FREE)
  credits          Int             @default(0)
  educationLevel   EducationLevel  @default(HIGH_SCHOOL)
  stripeCustomerId String?         @unique
  failedLogins     Int             @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  accounts         Account[]
  sessions         Session[]
  problems         Problem[]
  bookmarks        Bookmark[]
  conversations    TutorConversation[]
  practiceAttempts PracticeAttempt[]
  topicProgress    TopicProgress[]
  uploads          Upload[]
  usageEvents      UsageEvent[]
  subscriptions    Subscription[]
  auditLogs        AuditLog[]
  blogPosts        BlogPost[]

  @@index([createdAt])
  @@index([plan])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────── Billing ───────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripePriceId        String?
  plan                 Plan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─────────────────────────── Solving & learning ───────────────────────────

model Problem {
  id         String        @id @default(cuid())
  userId     String?
  guestId    String?
  input      String        @db.Text
  normalized String?       @db.Text
  category   String
  topic      String?
  answer     String?       @db.Text
  result     Json
  verified   Boolean       @default(false)
  source     ProblemSource @default(TEXT)
  createdAt  DateTime      @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([category])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, createdAt])
}

model TutorConversation {
  id        String         @id @default(cuid())
  userId    String
  title     String
  level     EducationLevel @default(HIGH_SCHOOL)
  problemId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, updatedAt])
}

model TutorMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PracticeAttempt {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  difficulty    Int      @default(1)
  question      String   @db.Text
  userAnswer    String   @db.Text
  correctAnswer String   @db.Text
  isCorrect     Boolean
  timeMs        Int?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, topic])
}

model TopicProgress {
  id             String   @id @default(cuid())
  userId         String
  topic          String
  attempts       Int      @default(0)
  correct        Int      @default(0)
  streak         Int      @default(0)
  mastery        Float    @default(0)
  lastPracticeAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

model Upload {
  id            String       @id @default(cuid())
  userId        String?
  guestId       String?
  storageKey    String       @unique
  mimeType      String
  sizeBytes     Int
  sha256        String
  status        UploadStatus @default(PENDING)
  ocrText       String?      @db.Text
  ocrConfidence Float?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([expiresAt, status])
  @@index([userId])
}

model UsageEvent {
  id           String    @id @default(cuid())
  userId       String?
  guestId      String?
  kind         UsageKind
  model        String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  costMicros   Int       @default(0)
  success      Boolean   @default(true)
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, kind, createdAt])
  @@index([guestId, kind, createdAt])
  @@index([createdAt])
}

// ─────────────────────────── CMS ───────────────────────────

model ContentPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  type           PageType      @default(PAGE)
  title          String
  description    String?
  body           String        @db.Text
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  noindex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type, status])
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  posts       BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  body           String        @db.Text
  coverImage     String?
  tags           String[]
  status         ContentStatus @default(DRAFT)
  categoryId     String?
  authorId       String?
  readingMinutes Int           @default(5)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Formula {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  category          String
  latex             String
  summary           String
  variables         Json
  explanation       String        @db.Text
  example           String        @db.Text
  relatedCalculator String?
  relatedTopics     String[]
  faqs              Json
  status            ContentStatus @default(PUBLISHED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([category, status])
}

model CalculatorContent {
  id             String   @id @default(cuid())
  slug           String   @unique
  enabled        Boolean  @default(true)
  title          String?
  intro          String?  @db.Text
  body           String?  @db.Text
  faqs           Json?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  scope     String   @default("global")
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, order])
}

model SeoOverride {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  ogImage     String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Security ───────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime

  @@index([resetAt])
}
